# Dependencies
node_modules/

# Build artifacts
# Minified CSS/JS are generated by `npm run build` and should not be committed.
# They are produced at deploy time by the GitHub Actions workflow.
css/*.min.css
js/*.min.js

# Vendored assets downloaded at build time (also produced by `npm run build`)
js/jquery-3.5.1.min.js
js/js.cookie.min.js
js/splide.min.js
js/splide-extension-auto-scroll.min.js
css/splide-core.min.css
images/custom-checkbox-checkmark.svg

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.iml

# Env / secrets
.env
.env.*
!.env.example

# Internal design exploration (not part of the live site)
design-concepts/

# Raw speaker source exports (contain personal emails, phone numbers,
# internal outreach notes, and promo codes — must never be published
# to the public GitHub Pages site)
2026 Website Speakers/
